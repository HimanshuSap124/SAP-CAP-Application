{
  "name": "cap-application",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.7.0",
    "@sap-cloud-sdk/http-client": "^4.7.0",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build": "mbt build -t gen --mtar mta.tar",
    "deploy": "cf deploy gen/mta.tar",
    "undeploy": "cf undeploy cap-application --delete-services --delete-service-keys"
  },
  "private": true,
  "cds": {
    "query": {
      "limit": {
        "default": 5,
        "max": 8
      }
    },
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      }
    }
  }
}
